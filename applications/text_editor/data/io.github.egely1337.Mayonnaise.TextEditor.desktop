[Desktop Entry]
Name=Forma Text
Name[zh_CN]=Forma 文本编辑器
Comment=A native plain text editor
Comment[zh_CN]=轻巧的原生纯文本编辑器
Exec=texteditor %f
TryExec=texteditor
