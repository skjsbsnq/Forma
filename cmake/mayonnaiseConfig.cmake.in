@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT "@BUILD_SHARED_LIBS@")
  find_dependency(SDL3 CONFIG)
  find_dependency(Freetype)
  find_dependency(OpenGL COMPONENTS OpenGL)
  if("@MAYONNAISE_HAS_WAYLAND_MATERIAL@")
    find_dependency(PkgConfig)
    pkg_check_modules(FORMA_WAYLAND REQUIRED IMPORTED_TARGET wayland-client)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/mayonnaiseTargets.cmake")
check_required_components(mayonnaise)
