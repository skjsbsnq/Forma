# Build the current local Forma source, including uncommitted changes.
pkgname=forma-finder
pkgver=0.1.0
pkgrel=21
pkgdesc='Forma Finder file manager with a custom Forma icon'
arch=(x86_64)
url='https://github.com/skjsbsnq/Forma'
license=(GPL-3.0-only OFL-1.1 MIT)
depends=(glibc gcc-libs sdl3 freetype2 fontconfig dbus hicolor-icon-theme xdg-utils glib2 udisks2)
makedepends=(cmake pkgconf vulkan-headers shaderc)
optdepends=('vulkan-icd-loader: Vulkan rendering' 'zenity: fallback file dialogs' 'ark: archive extraction from the context menu')
provides=(mayo-finder-git)
conflicts=(mayo-finder-git)
options=(!debug)
source=()
sha256sums=()

build() {
  cmake -S "$startdir/../.." -B "${FORMA_BUILD_DIR:-$srcdir/build}" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DMAYONNAISE_USE_SYSTEM_DEPS=ON -DMAYONNAISE_BUILD_TESTS=OFF
  cmake --build "${FORMA_BUILD_DIR:-$srcdir/build}" --target finder -j"${FORMA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "${FORMA_BUILD_DIR:-$srcdir/build}" --component finder
  install -Dm644 "$startdir/../../applications/finder/data/io.github.egely1337.Mayonnaise.Finder.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/forma-finder.svg"
  install -Dm644 "$startdir/../../LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 "$startdir/../../assets/fonts/Inter-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
}
