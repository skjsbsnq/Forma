# Maintainer: egely <egely1337@icloud.com>
#
# Forma System Settings, built from the git repository two directories up (whatever is committed on its
# checked-out branch):  cd packaging/arch && makepkg -si
#
# This is the package installed on this machine. It declares provides/conflicts for the older
# `mayo-system-settings-git` name because both packages ship /usr/bin/forma-settings and the same
# .desktop file, so installing one over the other has to be a replace, not a file conflict.
#
# Only the systemsettings CMake target is built: every other application has its own package.

pkgname=forma-settings
pkgver=0.1.0
pkgrel=5
pkgdesc='Forma System Settings with Simplified Chinese interface'
arch=(x86_64)
url='https://github.com/skjsbsnq/Forma'
license=(GPL-3.0-only OFL-1.1)
depends=(glibc gcc-libs sdl3 freetype2 fontconfig dbus hicolor-icon-theme glib2 gsettings-desktop-schemas)
optdepends=('vulkan-icd-loader: Vulkan rendering'
            'zenity: fallback file dialogs'
            'kscreen: KDE display configuration'
            'powerdevil: KDE power management'
            'plasma-workspace: KDE appearance integration'
            'networkmanager: network configuration'
            'bluez: Bluetooth'
            'libpulse: sound controls (pactl)'
            'upower: battery information'
            'power-profiles-daemon: power modes'
            'accountsservice: user accounts'
            'xdg-utils: open external settings'
            # Read directly by the panels added for KDE coverage; each degrades on its own when missing.
            'kwin: window decorations, desktop effects and KWin scripts'
            'libcups: Printers panel (a CUPS server is still needed)'
            'xdg-user-dirs: Locations panel defaults')
provides=(mayo-system-settings-git)
conflicts=(mayo-system-settings-git)
# Configuring the app tree still runs pkg-config for the other applications' libraries.
makedepends=(git cmake pkgconf sdl3 freetype2 glib2 vulkan-headers shaderc curl libsecret json-glib)
# Pinned to master: without a branch, makepkg keeps following whatever branch was checked out when it
# first cloned, and rebuilds that old commit forever.
source=("forma::git+file://${startdir}/../..#branch=master")
sha256sums=(SKIP)

build() {
  # stb's asserts embed __FILE__; keep the build directory out of the binary.
  CFLAGS+=" -ffile-prefix-map=$srcdir=."
  CXXFLAGS+=" -ffile-prefix-map=$srcdir=."
  cmake -B build -S forma \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMAYONNAISE_BUILD_APPS=ON \
    -DMAYONNAISE_BUILD_TESTS=OFF \
    -Wno-dev
  # One target: the library and the system settings app, nothing else.
  cmake --build build --target systemsettings -j"$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install build --component systemsettings

  # The .desktop file points Icon=forma-settings, so the icon has to carry that name as well (the install
  # component ships it under the desktop id).
  install -Dm644 forma/applications/system_settings/data/io.github.egely1337.Mayonnaise.Settings.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/forma-settings.svg"

  install -Dm644 forma/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 forma/assets/fonts/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
}
